# Copy this file to .env and fill in your own values from Supabase.
# .env is gitignored.
#
# IMPORTANT: write values without quotes — Docker reads this file itself
# and treats quotes as part of the value.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → anon public key. Safe to be
# non-secret — this is the key the standard client-side Supabase Auth flow
# uses, and it only ever grants what row-level security policies allow.
# Used both by the backend (to verify a request's JWT — see
# backend/src/auth.js) and by the browser (VITE_ variant below, to sign
# in/out — see src/supabaseClient.js).
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The port the backend listens on.
PORT=3000

# The backend address for the frontend. Leave it empty in development:
# Vite forwards /api to the backend itself (see vite.config.js).
# VITE_API_URL=
