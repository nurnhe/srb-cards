# Скопируй этот файл в .env и подставь свои значения из Supabase.
# Файл .env в git не попадает.
#
# ВАЖНО: пиши значения без кавычек — Docker читает этот файл сам,
# и кавычки он воспринимает как часть значения.
#
# EN: Copy this file to .env and fill in your own values from Supabase.
# .env is gitignored.
#
# IMPORTANT: write values without quotes — Docker reads this file itself
# and treats quotes as part of the value.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → service_role secret.
# Этот ключ даёт полный доступ к базе. Он остаётся только на сервере
# и никогда не попадает в браузер — поэтому у него НЕТ приставки VITE_.
# Никогда не переименовывай его в VITE_..., иначе он окажется в коде сайта.
#
# EN: this key gives full access to the database. It stays on the server only
# and never reaches the browser — which is why it has NO VITE_ prefix.
# Never rename it to VITE_..., or it will end up in the site's code.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Порт, на котором работает бэкенд.
# EN: the port the backend listens on.
PORT=3000

# Адрес бэкенда для фронтенда. В разработке оставь пустым:
# Vite сам перенаправляет /api на бэкенд (смотри vite.config.js).
#
# EN: the backend address for the frontend. Leave it empty in development:
# Vite forwards /api to the backend itself (see vite.config.js).
# VITE_API_URL=

# Ветке main (сайт на Netlify) всё ещё нужны старые переменные
# VITE_SUPABASE_URL и VITE_SUPABASE_ANON_KEY — они настраиваются
# в самом Netlify, а не здесь.
#
# EN: the main branch (the Netlify site) still needs the old
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY variables — those are
# configured in Netlify itself, not here.
