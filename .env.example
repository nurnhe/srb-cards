# Copy this file to .env and fill in your own values from Supabase.
# .env is gitignored.
#
# IMPORTANT: write values without quotes — Docker reads this file itself
# and treats quotes as part of the value.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → service_role secret.
# This key gives full access to the database. It stays on the server only
# and never reaches the browser — which is why it has NO VITE_ prefix.
# Never rename it to VITE_..., or it will end up in the site's code.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The port the backend listens on.
PORT=3000

# The password to open the site. One shared password, no username/login.
# Without it the backend refuses every data request.
APP_PASSWORD=change-me

# The backend address for the frontend. Leave it empty in development:
# Vite forwards /api to the backend itself (see vite.config.js).
# VITE_API_URL=

# The main branch (the Netlify site) still needs the old
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY variables — those are
# configured in Netlify itself, not here.
